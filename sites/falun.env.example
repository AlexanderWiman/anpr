SITE_ID=falun
CAMERA_ID=hall-1
DIRECTION=entry
# Single-camera fallback (used when CAMERAS_CONFIG is not set):
# CAMERA_RTSP_URL=rtsp://user:password@192.168.0.96:554/stream1
# Multi-hall Falun (2 cameras):
# CAMERAS_CONFIG=./sites/falun.cameras.json
# Per-camera ROI (Torrhall = upper band, Stora hallen = lower band):
DETECTION_ROI_ENABLED=true
DETECTION_ROI_TOP_FRACTION=0.35
DETECTION_ROI_BY_CAMERA={"entrance-1":{"band":"top","fraction":0.45},"entrance-2":{"band":"bottom","fraction":0.40}}
